---
import Base from '../layouts/Base.astro';
import events from '../data/events.yaml';
---

<Base title="Hosted Events" description="Conferences and events hosted by Marcel Olbert, bringing together scholars, policymakers, and practitioners on global tax policy.">
  <div class="wrap-text">
    <h1 class="page-title">Hosted Events</h1>
    <p class="page-lede">
      Conferences and workshops I have organized to connect academic research with
      policy and practice.
    </p>

    {events.map((event: any) => (
      <article class="event">
        <h2>{event.title}</h2>
        <div class="event-meta">{event.date} · {event.location}</div>
        <p>{event.description}</p>
        {event.links?.length > 0 && (
          <ul>
            {event.links.map((l: any) => <li><a href={l.url}>{l.label}</a></li>)}
          </ul>
        )}
        {event.photos?.length > 0 && (
          <div class={event.photos.some((p: any) => p.caption) ? 'event-photos event-photos--people' : 'event-photos'}>
            {event.photos.map((p: any) => typeof p === 'string'
              ? <img src={p} alt={event.title} loading="lazy" />
              : <figure><img src={p.src} alt={p.caption ?? event.title} loading="lazy" />{p.caption && <figcaption>{p.caption}</figcaption>}</figure>)}
          </div>
        )}
      </article>
    ))}
  </div>
</Base>
